# Environment Variables for Cryptocurrency Market Analyzer
# Copy this file to .env and fill in your values

# ============================================
# Kafka Configuration
# ============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRADES_TOPIC=crypto-trades

# ============================================
# Coinbase Exchange (public market data, no key needed)
# ============================================
# COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=crypto_db
POSTGRES_USER=crypto_user
POSTGRES_PASSWORD=change_me_in_production

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=  # Set if Redis requires authentication

# ============================================
# Application Settings
# ============================================
ENVIRONMENT=development  # development or production
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# ============================================
# pgAdmin credentials (used by docker-compose.yml)
# ============================================
PGADMIN_EMAIL=admin@crypto.dev
PGADMIN_PASSWORD=change_me_in_production

# ============================================
# Notes
# ============================================
# - Never commit .env file to Git (it's in .gitignore)
# - For production, use proper secrets management (Vault, AWS Secrets Manager)
# - Update ports if you changed them in docker-compose.yml
